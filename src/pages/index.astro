---
import type { MarkdownInstance } from 'astro';
import ListLink from '@components/ListLink.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDate } from '@utils/formatDate';
import type { PostFrontmatter } from '@/types';

const notes = Object.values(
  import.meta.glob<MarkdownInstance<PostFrontmatter>>('./notes/*.md', {
    eager: true,
  }),
)
  .sort((a, b) => {
    return new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
  })
  .slice(0, 3);
---

<BaseLayout>
  {
    !!notes.length && (
      <section>
        <h1>Последние заметки</h1>
        <ol>
          {notes.map(({ frontmatter, url }) => (
            <ListLink link={url} title={frontmatter.title} description={formatDate(frontmatter.date, 'ru-RU')} />
          ))}
        </ol>
        <a href="/notes">показать всё</a>
      </section>
    )
  }

  <style>
    section {
      margin-bottom: 2rem;

      ol {
        list-style: none;
        padding-left: 1rem;
      }
    }
  </style>
</BaseLayout>
