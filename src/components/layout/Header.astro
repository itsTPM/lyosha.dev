---
import GitHubLogo from "@icons/github.svg";
import TelegramLogo from "@icons/telegram.svg";
import GmailLogo from "@icons/gmail.svg";
---

<header>
  <a class="domain" href="/">Lyosha<span class="domain-zone">.dev</span></a>

  <ol class="social-list">
    <li class="social-item">
      <a href="https://github.com/itsTPM" class="social-link">
        <GitHubLogo class="social-icon" aria-label="GitHub" />
      </a>
    </li>
    <li class="social-item">
      <a href="https://t.me/itsTPM" class="social-link">
        <TelegramLogo class="social-icon" aria-label="Telegram" />
      </a>
    </li>
    <li class="social-item">
      <a href="mailto:lyoshakirpel@gmail.com" class="social-link">
        <GmailLogo class="social-icon" aria-label="Email" />
      </a>
    </li>
  </ol>
</header>

<style>
  .domain {
    color: var(--pico-h1-color);
    font-family: "Raleway", sans-serif;
    font-weight: 600;
    font-size: 1.75rem;
    display: block;
    text-decoration: none;
    width: fit-content;
    transition: color 0.2s ease-out;
    padding: 0 0.5rem;
    margin: 0 -0.5rem;
    margin-bottom: 0.5rem;

    .domain-zone {
      transition: color 0.2s ease-out;
      color: var(--pico-primary);
    }

    &:hover {
      color: var(--pico-primary);

      .domain-zone {
        color: var(--pico-h1-color);
      }
    }
  }

  .social-list {
    display: inline-grid;
    grid-auto-flow: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .social-item {
    height: 1.5rem;
    aspect-ratio: 1;

    &:hover {
      .social-icon {
        color: var(--pico-primary);
      }
    }
  }

  .social-link {
    display: block;
  }

  .social-icon {
    color: var(--pico-h2-color);
    transition: color 0.2s ease-out;
  }
</style>
